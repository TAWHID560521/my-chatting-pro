# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_PUBLIC_BASE_URL=https://my-chatting-pro-api.onrender.com
SUPPORT_EMAIL=hafeztawhid15@gmail.com

# PostgreSQL (Render Managed PostgreSQL or external)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/my_chatting_pro?sslmode=require

# Redis (Render Key Value / Upstash / Redis)
REDIS_URL=redis://:PASSWORD@HOST:6379

# JWT Secrets (generate 64-byte random hex secrets)
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Private S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=my-chatting-pro-private
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true
PRESIGNED_UPLOAD_TTL_SECONDS=300
PRESIGNED_DOWNLOAD_TTL_SECONDS=120

# WebRTC STUN/TURN (Coturn / Metered / Cloudflare Calls TURN)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.yourdomain.com:3478
TURN_TLS_URL=turns:turn.yourdomain.com:5349
TURN_SHARED_SECRET=REPLACE_WITH_COTURN_STATIC_AUTH_SECRET
